{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal evidence with audit trail",
  "type": "object",
  "required": ["evidence_id", "candidate_id", "theme", "subtheme", "evidence_level", "neutral_summary", "original_excerpt", "page", "source_file", "source_sha256", "target_population", "proposed_action", "limitations", "prompt_version", "model", "generated_at", "review_status", "reviewed_at", "reviewer", "review_notes"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "theme": {"type": "string", "minLength": 1},
    "subtheme": {"type": "string", "minLength": 1},
    "evidence_level": {"type": "integer", "enum": [0, 1, 2, 3]},
    "neutral_summary": {"type": "string", "minLength": 1},
    "original_excerpt": {"type": "string", "minLength": 1},
    "page": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "target_population": {"type": "string", "minLength": 1},
    "proposed_action": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prompt_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "review_status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewer": {"type": ["string", "null"]},
    "review_notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "approved"}}, "required": ["review_status"]},
      "then": {"properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}}}
    }
  ],
  "additionalProperties": false
}
